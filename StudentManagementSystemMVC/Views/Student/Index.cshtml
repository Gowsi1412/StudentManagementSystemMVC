@model List<StudentManagementSystemMVC.Models.Student>

<h2>Student List</h2>

<a asp-action="Create">Add Student</a>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Age</th>
        <th>Class</th>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentID</td>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.Class</td>
            <td>@item.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StudentID">Edit</a>

                |

                <a asp-action="Delete"
                   asp-route-id="@item.StudentID">
                    Delete
                </a>
            </td>
        </tr>
    }
</table>